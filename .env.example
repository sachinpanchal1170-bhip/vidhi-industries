# Production domain (canonical URLs, sitemap, Open Graph). No trailing slash.
VITE_SITE_URL=https://www.vidhiindustries.com

# Contact form delivery — any JSON form service.
#   Formspree: VITE_FORM_ENDPOINT=https://formspree.io/f/your-form-id
#   Web3Forms: VITE_FORM_ENDPOINT=https://api.web3forms.com/submit  + VITE_FORM_ACCESS_KEY=your-key
# Leave empty and the form offers "Send via WhatsApp" instead (never fakes success).
VITE_FORM_ENDPOINT=
VITE_FORM_ACCESS_KEY=

# true  = show proposed services/industries + placeholder images with review tags
# false = public launch: show only confirmed content and real photos
VITE_REVIEW_MODE=true
